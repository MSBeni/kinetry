{
  "id": "annotated_mock", "name": "Annotated screenshot",
  "purpose": "A realistic email, document, message or web page with numbered callouts that highlight parts of it as they're named.",
  "use_when": ["spot-the-red-flags", "walking through a form, screen or message", "what to look at first"],
  "avoid_when": ["abstract ideas with nothing concrete to show"],
  "tags": ["show", "security", "software"],
  "fields": {
    "eyebrow": {"type": "text", "max": 40, "role": "eyebrow", "optional": true},
    "kind": {"type": "enum", "values": ["email", "document", "message", "webpage"], "desc": "Window style"},
    "address": {"type": "text", "max": 60, "lines": 1, "role": "small", "optional": true, "desc": "URL for webpage"},
    "header": {"type": "list", "min": 0, "max": 3, "optional": true, "desc": "e.g. From / To lines", "of": {"type": "object", "fields": {
      "label": {"type": "text", "max": 12, "lines": 1, "role": "small"},
      "text": {"type": "text", "max": 70, "lines": 1, "role": "body"}}}},
    "title": {"type": "text", "max": 80, "lines": 2, "role": "h3", "optional": true, "desc": "Subject or heading"},
    "body": {"type": "text", "max": 260, "lines": 6, "role": "body", "optional": true},
    "button": {"type": "text", "max": 24, "lines": 1, "role": "item", "optional": true},
    "callouts": {"type": "list", "min": 1, "max": 3, "of": {"type": "object", "fields": {
      "target": {"type": "enum", "values": ["address", "header.0", "header.1", "header.2", "title", "body", "button"]},
      "title": {"type": "text", "max": 28, "lines": 1, "role": "h3"},
      "text": {"type": "text", "max": 80, "lines": 2, "role": "body"}}}}
  },
  "reveals": [{"key": "mock"}, "callouts.*"],
  "layouts": {"side": {"formats": ["16:9"], "desc": "Window left, callout notes right"}, "stack": {"formats": ["9:16", "1:1"], "desc": "Window on top, notes below"}},
  "example": {"eyebrow": "Three red flags", "kind": "email",
              "header": [{"label": "From", "text": "IT Support <helpdesk@ledgerl1ne-help.com>"}, {"label": "To", "text": "you@ledgerline.com"}],
              "title": "URGENT: Your account will be locked in 24 hours",
              "body": "We detected unusual activity on your account. Verify your identity immediately or it will be permanently locked.",
              "button": "Verify account",
              "callouts": [{"target": "header.0", "title": "The sender", "text": "'ledgerl1ne' uses the number 1, not an L."},
                           {"target": "title", "title": "The pressure", "text": "Urgent, locked, 24 hours. Rushing you is the point."},
                           {"target": "button", "title": "The link", "text": "Hover first: it points to a site that isn't ours."}]},
  "example_beats": [{"say": "Here's an email that looks routine.", "show": ["mock"]},
                    {"say": "First, the sender: that's a one, not an L.", "show": ["callouts.0"]},
                    {"say": "Second, the pressure. Rushing you is the point.", "show": ["callouts.1"]},
                    {"say": "Third, hover before you click.", "show": ["callouts.2"]}]
}
